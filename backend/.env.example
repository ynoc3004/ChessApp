# Copy to backend/.env if you prefer to configure manually.
# backend/.env is ignored by Git and must never be committed.
CHESSAPP_ADMIN_TOKEN=change-me
# Account login sessions default to 12 hours. Allowed range: 1-168 hours.
CHESSAPP_ADMIN_SESSION_HOURS=12
# Scanner v2: a single PDF page / DOCX image is skipped after this many seconds.
# Allowed effective range is 15-600 seconds.
CHESSAPP_SCANNER_PAGE_TIMEOUT=60
